# Copy to .env.local for local development. Everything is optional locally.

# Postgres connection (Neon or Supabase free tier in production).
# Leave unset locally to use the embedded database stored in .data/.
DATABASE_URL=

# At least 32 random characters. Required in production.
SESSION_SECRET=

# Comma-separated phone numbers that become admins when they sign in.
ADMIN_PHONES=0712345678

# SMS sign-in codes via Africa's Talking. Use AT_USERNAME=sandbox for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Shows sign-in codes on screen instead of texting them. Never enable on a public site.
OTP_DEV_MODE=false

# Keep false until a Kenyan gaming lawyer confirms paid entry is allowed.
PAID_ENTRY_ENABLED=false

# Test deployments only: puts the whole site behind a browser password prompt.
SITE_PASSWORD=

# ---------------------------------------------------------------- gift card shop

# Encrypts gift card codes in the database. 64 random hex characters. Never change it once orders exist.
CODE_ENCRYPTION_KEY=

# Public address of the site, used for payment callbacks, e.g. https://g-money.vercel.app
PUBLIC_BASE_URL=

# Gift card supplier: "test" (fake codes) or "reloadly" (needs a registered business account).
SUPPLIER=test
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

# Test sites only: "simulated" lets testers press a button instead of paying.
PAYMENTS_MODE=

# M-Pesa (Safaricom Daraja STK push). MPESA_ENV=production for live payments.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random string that forms part of the callback URL, so only Safaricom can report payments.
MPESA_CALLBACK_SECRET=

# Card payments through Paystack. Set the webhook URL in Paystack to PUBLIC_BASE_URL/api/payments/paystack
PAYSTACK_SECRET_KEY=

# Shop rules (defaults shown).
MARKUP_PERCENT=5
CARD_FEE_PERCENT=3.5
NEW_ACCOUNT_DAYS=7
NEW_ACCOUNT_DAILY_KES=5000
DAILY_LIMIT_KES=50000
